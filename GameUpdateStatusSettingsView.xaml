<UserControl x:Class="GameUpdateStatus.GameUpdateStatusSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="10">

        <CheckBox
            Content="Enable Epic update status"
            IsChecked="{Binding EnableSourceEpic}"
            Margin="0,0,0,10" />

        <CheckBox
            Content="Show red dot on unsupported sources"
            IsChecked="{Binding ShowRedDotOnUnsupportedSource}"
            Margin="0,0,0,10" />

        <TextBox
            Text="{Binding CacheDurationMinutes}"
            Width="100"
            HorizontalAlignment="Left"/>
            
        <Button
            Content="Vériifier les mises à jour maintenant"
            Click="CheckForUpdates_Click"
            Width="180"
            HorizontalAlignment="Left"
            Margin="0,10,0,0" />

    </StackPanel>

</UserControl>
<UserControl x:Class="GameUpdateStatus.GameUpdateStatusSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="30">

        <CheckBox
            Content="Activer la vérification des mises à jour des jeux Epic"
            IsChecked="{Binding EnableSourceEpic}"
            Margin="0,0,0,20" />

        <CheckBox
            Content="Afficher le point rouge sur les sources non supportées"
            IsChecked="{Binding ShowDotOnUnsupportedSource}"
            Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock>Durée du cache :</TextBlock>
            <TextBox
                Text="{Binding CacheDurationMinutes}"
                Width="100"
                Margin="10,0,10,0"/>
            <TextBlock>min</TextBlock>
        </StackPanel>

        <Button
            Content="Vérifier les mises à jour maintenant"
            Click="CheckForUpdates_Click"
            Width="250"
            HorizontalAlignment="Left"
            Margin="0,0,0,20" />

    </StackPanel>

</UserControl>
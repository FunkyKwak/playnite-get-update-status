<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>

    <OutputType>Library</OutputType>

    <RootNamespace>GameUpdateStatus</RootNamespace>
    <AssemblyName>GameUpdateStatus</AssemblyName>

    <LangVersion>latest</LangVersion>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>

    <Reference Include="PlayniteSDK">
      <HintPath>
        C:\Users\%USERNAME%\AppData\Local\Playnite\Playnite.SDK.dll
      </HintPath>
    </Reference>

    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />

  </ItemGroup>

  <ItemGroup>
    <Page Include="Controls\UpdateStatusControl.xaml" />
  </ItemGroup>

</Project>